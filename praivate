-- invoke
local function PurchaseItem(itemName)
    local remote = ReplicatedStorage:WaitForChild("Purchasing", 5)
    if remote then
        local success, err = pcall(function()
            remote:InvokeServer(itemName, 149827570)
        end)
        if not success then warn("Purchase failed for " .. itemName) end
    end
end

